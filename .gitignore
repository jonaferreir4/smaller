# =============================================================================
# Smaller Monorepo - Git Ignore Rules
# =============================================================================

# .NET & C# Build Artifacts
**/bin/
**/obj/
**/wwwroot/
*.user
*.suo
*.userosscache
*.sln.docstates

# Node.js, Frontend & Bundler Artifacts
**/node_modules/
**/dist/
**/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# Environment & Sensitive Files
.env
.env.*
!.env.example
backend/.env
frontend/.env
appsettings.Development.json
secrets.json

# Docker & Local Overrides
**/docker-compose.override.yml

# IDEs & Operating System
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.sw?
.DS_Store
Thumbs.db