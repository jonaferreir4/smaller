# Banco de dados
DB_HOST=db
DB_PORT=5432
DB_NAME=smallerdb
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Domínios
DOMAIN_NAME=short.local
DOMAIN_NAME_FRONT=short.local.front

# Autenticação JWT (SaaS)
JWT_SECRET=your_32byte_random_secret_key_here
JWT_ISSUER=smaller-api
JWT_AUDIENCE=smaller-client

# Cotas de Planos
FREE_PLAN_LINK_LIMIT=100

# Email para Let's Encrypt
LE_EMAIL=your_email@domain.com
